# ============ AI 模型配置 ============
# 供应商选择：auto | mock | openai_compatible
#   auto              : 有可用 API key 则走真实模型，否则进入 Mock 演示引擎（推荐）
#   mock              : 强制 Mock（仅内置示例可演示）
#   openai_compatible : 强制真实模型（无 key 时相关请求将报错）
AI_PROVIDER=auto

# OpenAI 兼容端点（可指向 OpenAI / DeepSeek / 智谱 GLM / 通义 / Moonshot 等任意兼容服务）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 视觉理解模型（须支持 image_url 输入）
VISION_MODEL=gpt-4o-mini
# 文本生成模型
TEXT_MODEL=gpt-4o-mini

# ============ 上传限制 ============
MAX_IMAGE_MB=8

# ============ 主体抠图（透明图） ============
# 抠图依赖 rembg：先执行 pip install -r backend/requirements-segmentation.txt
#（首次使用会自动下载 u2net 权重约 170MB，缓存位置见下方 U2NET_HOME）
# 模型缓存目录（默认项目根 models/，无需修改；如需改位置可在此设置）
# U2NET_HOME=models
# 抠图模型：u2net（通用，默认）| isnet-general-use（更精细，首次需额外下载）
# SEGMENT_MODEL=u2net
